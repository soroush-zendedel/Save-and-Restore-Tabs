{
  "manifest_version": 3,
  "name": "Save and Restore Tabs",
  "version": "1.0.0",
  "description": "Save open tab links to a text file and reopen them later.",
  "permissions": ["tabs"],
  "action": {
    "default_title": "Save and Restore Tabs",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "save-and-restore-tabs@soroush-zendedel.github.io",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/soroush-zendedel/Save-and-Restore-Tabs/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
